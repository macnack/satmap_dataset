# satmap_dataset provider credentials.
#
# Copy this file to `.secret` (gitignored) and fill in real values, then run
# `direnv allow` from the repo root. The .envrc auto-sources .secret so the
# pipeline picks the env vars up automatically.
#
#   cp .secret.template .secret
#   chmod 600 .secret
#   $EDITOR .secret
#   direnv allow

# NLS Finland — free API key from https://omatili.maanmittauslaitos.fi/
SATMAP_NLS_API_KEY=

# Lantmäteriet — Geotorget API credentials for "Ortofoto Nedladdning".
# Geotorget issues a separate username + password per subscribed product.
# These are NOT your lantmateriet.se website login.
SATMAP_LANTMATERIET_USERNAME=
SATMAP_LANTMATERIET_PASSWORD=

# Optional: Markhöjdmodell Nedladdning (Swedish DEM / STAC-höjd).
# Usually a *separate* Geotorget product from Ortofoto — ortofoto credentials
# typically return 401 on dl1.lantmateriet.se/hojd/... Prefer DEM-specific
# vars when your höjd subscription uses different credentials; otherwise the
# DEM client falls back to SATMAP_LANTMATERIET_USERNAME/PASSWORD.
# SATMAP_LANTMATERIET_DEM_USERNAME=
# SATMAP_LANTMATERIET_DEM_PASSWORD=
# SATMAP_LANTMATERIET_STAC_HOJD_URL=https://api.lantmateriet.se/stac-hojd/v1/search
# SATMAP_LANTMATERIET_STAC_HOJD_COLLECTION=dtm-cog

# Optional: override defaults for the Lantmäteriet orthophoto provider.
# SATMAP_LANTMATERIET_STAC_URL=https://api.lantmateriet.se/stac-bild/v1/search
# SATMAP_LANTMATERIET_STAC_COLLECTION=
# SATMAP_LANTMATERIET_API_KEY=
# SATMAP_LANTMATERIET_WMS_URL=
# SATMAP_LANTMATERIET_WMS_LAYER=

# Optional data roots (defaults: ~/sat_data_raw and ~/sat_data)
# SATMAP_RAW_ROOT=
# SATMAP_GMIX_DEST=
